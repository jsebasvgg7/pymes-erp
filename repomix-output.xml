}

.pos__line--head {
	font-size: 13px;
}

.pos__line--head .pos__num {
	color: var(--ink);
}

.pos__lines {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
	gap: 10px;
}

.pos__lines .pos__line {
	color: var(--ink);
}

.pos__lineName {
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.pos__num--ink {
	color: var(--ink);
}

.pos__lineQty {
	color: var(--muted);
}

.pos__num {
	font-weight: 500;
	white-space: nowrap;
}




.pos__pill {
	position: relative;
	max-width: 190px;
	min-width: 0;
}

.pos__pill select {
	box-sizing: border-box;
	width: 100%;
	height: 30px;
	padding: 0 28px 0 12px;
	font: inherit;
	font-size: 12px;
	font-weight: 500;
	color: var(--ink);
	background: var(--paper);
	border: 1px solid var(--line);
	border-radius: 999px;
	outline: none;
	appearance: none;
	cursor: pointer;
	text-overflow: ellipsis;
	transition: border-color 160ms ease, background 160ms ease;
}

.pos__pill select:hover {
	background: var(--surface);
}

.pos__pill select:focus {
	border-color: var(--ink);
}

.pos__pill svg {
	position: absolute;
	top: 50%;
	right: 10px;
