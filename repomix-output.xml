	pointer-events: none;
}

.pos__hint {
	margin: -4px 0 0;
	font-size: 11.5px;
	color: var(--muted);
	text-align: right;
}

.pos__cash {
	display: grid;
	gap: 8px;
	padding: 10px 12px;
	background: var(--surface);
	border-radius: 12px;
}

.pos__received {
	box-sizing: border-box;
	width: 130px;
	height: 30px;
	padding: 0 12px;
	text-align: right;
	font: inherit;
	font-size: 12px;
	font-weight: 600;
	color: var(--ink);
	background: var(--paper);
	border: 1px solid transparent;
	border-radius: 999px;
	outline: none;
}

.pos__received:focus {
	border-color: var(--ink);
}

.pos__received::placeholder {
	color: var(--muted);
	font-weight: 400;
}

.pos__discount {
	background: var(--surface);
}

.pos__discount:focus {
	background: var(--paper);
}



.pos__line--change {
	color: var(--ink);
	font-weight: 600;
}

.pos__line--danger {
	color: var(--pos-danger);
}

.pos__line--total {
	padding-top: 10px;
	border-top: 1px solid var(--line);
	font-size: 15px;
	font-weight: 600;
	color: var(--ink);
}

.pos__line--total .pos__num {
	font-size: 20px;
	font-weight: 600;
	letter-spacing: -0.01em;
}

.pos__formError {
	flex-shrink: 0;
	font-size: 13px;
	color: var(--pos-danger);
	background: color-mix(in srgb, var(--pos-danger) 8%, transparent);
	border: 1px solid color-mix(in srgb, var(--pos-danger) 22%, transparent);
	border-radius: 10px;
	padding: 10px 12px;
}

.pos__ctas {
	display: grid;
	gap: 8px;
	flex-shrink: 0;
}

.pos .pos__cta.ui-btnPrimary,
.pos .pos__cta.ui-btnSecondary {
	width: 100%;
	height: 44px;
	padding: 0 20px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	border-radius: 999px;
	font-size: 13px;
	font-weight: 600;
	letter-spacing: 0.05em;
	text-transform: uppercase;
}

.pos__empty {
	display: grid;
	gap: 6px;
	text-align: center;
	padding: 36px 10px;
}

.pos__empty--card {
	padding: 22px 10px;
}

.pos__emptyTitle {
	font-size: 14px;
	font-weight: 600;
	color: var(--ink);
}

.pos__emptySubtitle {
	font-size: 13px;
	color: var(--muted);
}

.pos__state {
	padding: 48px 24px;
	text-align: center;
	color: var(--muted);
	background: var(--paper);
	border-radius: 14px;
	border: 1px solid var(--surface);
}

.pos__state--error {
	color: var(--pos-danger);
	background: color-mix(in srgb, var(--pos-danger) 6%, transparent);
	border-color: color-mix(in srgb, var(--pos-danger) 18%, transparent);
}

.pos__modalHead {
	display: grid;
	gap: 4px;
}

.pos__modalTitle {
	display: flex;
	align-items: center;
	gap: 8px;
	font-size: 17px;
	font-weight: 500;
	color: var(--ink);
}

.pos__modalSubtitle {
	margin: 0;
	font-size: 11.5px;
	font-weight: 400;
	color: color-mix(in srgb, var(--muted) 75%, transparent);
}

.pos__modalActions {
	display: flex;
	gap: 10px;
	justify-content: flex-end;
	width: 100%;
}

.pos__confirmHead {
	display: flex;
	align-items: center;
	gap: 12px;
}

.pos__confirmIcon {
	width: 38px;
	height: 38px;
	flex-shrink: 0;
	display: grid;
	place-items: center;
	color: var(--pos-danger);
	background: color-mix(in srgb, var(--pos-danger) 8%, transparent);
	border: 1px solid color-mix(in srgb, var(--pos-danger) 22%, transparent);
	border-radius: 11px;
}

.pos__confirm {
	display: grid;
	gap: 14px;
}

.pos__confirmText {
	margin: 0;
	font-size: 13px;
	line-height: 1.55;
	color: var(--muted);
	text-wrap: pretty;
}

.pos__confirmSummary {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 12px 14px;
	font-size: 13px;
	color: var(--muted);
	background: var(--surface);
	border-radius: 12px;
}

.pos__confirmSummary strong {
	font-size: 15px;
	font-weight: 600;
	color: var(--ink);
}

.pos__modalActions--split {
	display: grid;
	grid-template-columns: 1fr 1fr;
}

.pos .pos__modalActions--split .ui-btnPrimary,
.pos .pos__modalActions--split .ui-btnSecondary {
	height: 40px;
	justify-content: center;
	border-radius: 999px;
	font-size: 12px;
	font-weight: 600;
	letter-spacing: 0.05em;
	text-transform: uppercase;
}

.pos__ticket {
	display: grid;
	gap: 14px;
	font-size: 12px;
	color: var(--ink);
}

.pos__ticketMeta {
	display: grid;
	gap: 8px;
	padding-bottom: 14px;
	border-bottom: 1px dashed var(--line);
}

.pos__ticketMeta div {
	display: flex;
	justify-content: space-between;
	gap: 12px;
}

.pos__ticketMeta span {
	color: var(--muted);
}

.pos__ticketItems {
	list-style: none;
	margin: 0;
	padding: 0 0 14px;
	display: grid;
	gap: 8px;
	border-bottom: 1px dashed var(--line);
}

.pos__ticketItems li {
	display: flex;
	justify-content: space-between;
	gap: 12px;
}

.pos__ticketTotals {
	display: grid;
	gap: 6px;
}

.pos__ticketTotals div {
	display: flex;
	justify-content: space-between;
	gap: 12px;
	color: var(--muted);
}

.pos__ticketTotals .pos__ticketTotal {
	padding: 4px 0;
	font-size: 15px;
	font-weight: 600;
	color: var(--ink);
}

.pos__mobileBar {
	display: none;
}

@media (max-width: 1100px) {
	.pos__layout {
		grid-template-columns: minmax(0, 1fr) minmax(300px, 0.9fr);
	}

	.pos__catalog {
		padding-right: 20px;
	}

	.pos__order {
		padding-left: 20px;
	}
}

@media (max-width: 860px) {
	.pos {
		padding-bottom: 76px;
	}

	.pos__layout {
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.pos__catalog {
		padding-right: 0;
		border-right: 0;
	}

	.pos__order {
		position: static;
		padding-left: 0;
		max-height: none;
	}

	.pos__orderScroll {
		max-height: 320px;
	}

	.pos__list {
		max-height: none;
		min-height: 0;
		padding-right: 0;
		scrollbar-gutter: auto;
	}

	.pos__sectionHead {
		flex-wrap: wrap;
	}

	.pos__search {
		flex: 1;
		width: auto;
		min-width: 180px;
	}

	.pos__mobileBar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
		background: var(--paper);
		border-top: 1px solid var(--line);
	}

	.pos__mobileTotal {
		display: grid;
		gap: 2px;
		font-size: 11px;
		color: var(--muted);
	}

	.pos__mobileTotal strong {
		font-size: 17px;
		font-weight: 600;
		color: var(--ink);
	}

	.pos .pos__mobileBtn.ui-btnPrimary {
		height: 40px;
		padding: 0 22px;
		border-radius: 999px;
		font-size: 12px;
	}
}

@media (max-width: 520px) {
	.pos__row {
		grid-template-columns: auto minmax(0, 1fr);
	}

	.pos__side {
		grid-column: 2;
		grid-template-columns: 1fr auto;
		align-items: center;
		justify-items: start;
	}

	.pos__tile {
		display: none;
	}

	.pos__rowMain {
		grid-template-columns: minmax(0, 1fr);
	}
}

@page {
	margin: 4mm;
}

@media print {
	body * {
		visibility: hidden;
	}

	.pos__ticket,
	.pos__ticket * {
		visibility: visible;
	}

	.pos__ticket {
		position: fixed;
		top: 0;
		left: 0;
		width: 80mm;
		padding: 0;
		font-size: 11px;
		color: #000;
		background: #fff;
	}
}
