.prod {
	display: grid;
	gap: 16px;
}

.prod__controls {
	display: grid;
	grid-template-columns: 1fr auto;
	align-items: end;
	gap: 12px;
}

.prod__search {
	display: grid;
	gap: 8px;
}

.prod__searchLabel {
	font-size: 13px;
	color: var(--muted);
	line-height: 1.2;
	visibility: hidden;
}

.prod__filters {
	display: flex;
	align-items: flex-end;
	gap: 12px;
}

.prod__filter {
	display: grid;
	gap: 8px;
}

.prod__filterLabel {
	font-size: 13px;
	color: var(--muted);
}

.prod__table {
	min-width: 0;
}

.prod__empty {
	display: grid;
	gap: 6px;
	text-align: center;
	padding: 26px 10px;
}

.prod__emptyTitle {
	font-size: 14px;
	font-weight: 650;
	color: var(--ink);
}

.prod__emptySubtitle {
	font-size: 13px;
	color: var(--muted);
}

.prod__emptyEmph {
	font-weight: 650;
	color: var(--ink);
}

.prod__modalActions {
	display: flex;
	gap: 10px;
	justify-content: flex-end;
	width: 100%;
}

.prod__noCats {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding: 14px;
	border-radius: 14px;
	border: 1px solid var(--line);
	background: var(--surface);
	margin-bottom: 14px;
}

.prod__noCatsTitle {
	font-size: 13px;
	color: var(--muted);
	line-height: 1.35;
	flex: 1 1 auto;
}

.prod__noCatsActions {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	flex: 0 0 auto;
}

.prod__form {
	margin-top: 2px;
}

.prod__grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 12px;
	align-items: start;
}

.prod__field {
	display: grid;
	gap: 8px;
}

.prod__field--full {
	grid-column: 1 / -1;
}

.prod__label {
	font-size: 13px;
	color: var(--muted);
}

.prod__input,
.prod__select {
	box-sizing: border-box;
	width: 100%;
	height: 44px;
	padding: 0 12px;
	border-radius: 12px;
	border: 1px solid var(--line);
	background: var(--paper);
	color: var(--ink);
	outline: none;
	transition: border-color 160ms ease, box-shadow 160ms ease;
	font: inherit;
	font-size: 14px;
}

.prod__input::placeholder {
	color: var(--muted);
}

.prod__input:focus,
.prod__select:focus {
	border-color: var(--ink);
	box-shadow: 0 0 0 4px var(--surface);
}

.prod__select option {
	background: var(--paper);
	color: var(--ink);
}

.prod__input:disabled,
.prod__select:disabled {
	background: var(--surface);
	color: var(--muted);
	cursor: not-allowed;
}

.prod__textarea {
	box-sizing: border-box;
	width: 100%;
	padding: 12px;
	border-radius: 12px;
	border: 1px solid var(--line);
	background: var(--paper);
	color: var(--ink);
	outline: none;
	resize: vertical;
	transition: border-color 160ms ease, box-shadow 160ms ease;
	font: inherit;
	font-size: 14px;
	line-height: 1.4;
	min-height: 96px;
}

.prod__textarea::placeholder {
	color: var(--muted);
}

.prod__textarea:focus {
	border-color: var(--ink);
	box-shadow: 0 0 0 4px var(--surface);
}

.prod__hint {
	font-size: 12px;
	color: var(--muted);
	line-height: 1.3;
}

.prod__state {
	padding: 48px 24px;
	text-align: center;
	color: var(--muted);
	background: var(--paper);
	border-radius: 14px;
	border: 1px solid var(--surface);
}

.prod__state--error {
	color: #b91c1c;
	background: rgba(220,38,38,0.06);
	border-color: rgba(220,38,38,0.18);
}

.prod__formError {
	font-size: 13px;
	color: #b91c1c;
	background: rgba(220,38,38,0.1);
	border: 1px solid rgba(220,38,38,0.22);
	border-radius: 10px;
	padding: 10px 12px;
}

@media (max-width: 860px) {
	.prod__controls {
		grid-template-columns: 1fr;
	}

	.prod__filters {
		justify-content: flex-start;
		flex-wrap: wrap;
	}
}

@media (max-width: 520px) {
	.prod__grid {
		grid-template-columns: 1fr;
	}

	.prod__noCats {
		flex-direction: column;
		align-items: stretch;
	}

	.prod__noCatsActions {
		justify-content: flex-end;
	}
}
</file>

