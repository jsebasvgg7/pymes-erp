}

.pos__ctrl--trash {
	margin-right: 4px;
	color: var(--pos-danger);
	border-color: color-mix(in srgb, var(--pos-danger) 22%, transparent);
	background: color-mix(in srgb, var(--pos-danger) 8%, transparent);
}

.pos__ctrl--trash:hover:not(:disabled) {
