	gap: 4px 14px;
	font-size: 11px;
	color: var(--muted);
}

.pos__status--low {
	color: var(--pos-warn);
}

.pos__status--out {
	color: var(--pos-danger);
}

.pos__status--ok {
	color: var(--pos-ok);
}

.pos__side {
	display: grid;
	justify-items: end;
	gap: 8px;
}

.pos__price {
	font-size: 14px;
	font-weight: 600;
