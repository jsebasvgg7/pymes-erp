}

@media (max-width: 520px) {
	.rep__metrics {
		grid-template-columns: 1fr;
	}

	.rep__periodFields,
	.rep__dateField {
		width: 100%;
	}

	.rep__exportButton {
		flex-shrink: 0;
	}
}
